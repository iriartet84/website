# Copy to .env.local for development. Never commit values.

# Neon Postgres
DATABASE_URL=

# Better Auth (generate a long random secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=

# Public site origin for metadata, sitemap, and auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Netlify Blobs (set automatically on Netlify; local fallback uses .data/blobs)
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Self-hosted Tectonic compiler (Render / Fly)
LATEX_COMPILE_URL=
LATEX_COMPILE_SECRET=
