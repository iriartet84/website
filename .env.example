# Copy to .env.local for development. Never commit values.

# Neon Postgres
DATABASE_URL=

# Better Auth (generate a long random secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=

# Public site origin for metadata, sitemap, and auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Netlify Blobs (set automatically on Netlify; local fallback uses .data/blobs)
# Legacy PDF storage — used only for PDFs uploaded before S3_BUCKET (below)
# was configured, and by the migration script (scripts/migrate-blobs-to-s3.ts).
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# S3-compatible storage for PDFs (Backblaze B2, AWS S3, ...). The bucket is
# private — when all of these are set, PDF uploads go straight from the
# browser to the bucket via a presigned PUT URL, and downloads are served
# through a short-lived presigned GET URL (see lib/blobs.ts and
# app/api/files/[key]/route.ts), bypassing Netlify Functions' small
# effective size limit on binary payloads without ever making the bucket
# public. Leave unset to keep using Netlify Blobs/local-filesystem storage.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Region: use the actual AWS region for S3. For B2, this is the region in
# your bucket's S3 endpoint, e.g. "eu-central-003".
S3_REGION=auto
# Endpoint: leave unset for real AWS S3. For B2, this is the bucket's S3 API
# endpoint, e.g. https://s3.eu-central-003.backblazeb2.com
S3_ENDPOINT=

# Self-hosted Tectonic compiler (Render / Fly)
LATEX_COMPILE_URL=
LATEX_COMPILE_SECRET=

# Live projects (lib/project-refresh.ts, app/api/projects/refresh).
# Shared secret for POST /api/projects/refresh: each project repository's
# workflow sends it (as its PORTFOLIO_REFRESH_SECRET secret) after
# publishing new output, and so does the scheduled Netlify function.
# Generate a long random value, e.g. `openssl rand -hex 32`.
PROJECT_REFRESH_SECRET=
# Comma-separated https origins whose apps project pages may embed (added to
# the CSP frame-src at build time), e.g. https://<user>.github.io
PROJECT_EMBED_ORIGINS=
